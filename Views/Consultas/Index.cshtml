@model IEnumerable<AgendaConsultas.Models.Consulta>

@{
    ViewData["Title"] = "Minhas Consultas";
}

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">
        @TempData["Sucesso"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h2>Minhas Consultas</h2>

    <a asp-controller="Consultas"
       asp-action="Create"
       class="btn btn-primary">
        Nova Consulta
    </a>

</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Você ainda não possui consultas cadastradas.
    </div>
}
else
{
    <table class="table table-striped table-bordered">

        <thead>
            <tr>
                <th>Especialidade</th>
                <th>Data e Hora</th>
                <th>Descrição</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var consulta in Model)
            {
                <tr>

                    <td>
                        @consulta.Especialidade
                    </td>

                    <td>
                        @consulta.DataHora.ToString("dd/MM/yyyy HH:mm")
                    </td>

                    <td>
                        @consulta.Descricao
                    </td>

                    <td>

                        <a asp-action="Edit"
                           asp-route-id="@consulta.Id"
                           class="btn btn-sm btn-warning">
                            Editar
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@consulta.Id"
                           class="btn btn-sm btn-danger">
                            Excluir
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>
}